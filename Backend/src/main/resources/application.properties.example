spring.application.name=mednexus

spring.datasource.url=jdbc:mysql://localhost:3306/MedNexus?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=your-db-password

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.jpa.properties.hibernate.globally_quoted_identifiers=true
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=25MB

jwt.secret=dev-only-change-in-production-use-at-least-32-bytes-for-hmac-sha-256-keys
jwt.access-expiration-ms=900000
jwt.refresh-expiration-ms=604800000

# Gmail SMTP for login OTP (use a Google App Password, not your account password)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${EMAIL_USER}
spring.mail.password=${EMAIL_PASS}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
mednexus.mail.from=${EMAIL_USER}
